#!/bin/sh
# Runs telegram-insights with credentials loaded from pass at call time.
# Usage: telegram-insights-with-pass <command> [args...]
# Secrets stay in the process environment only; nothing is written to disk.
# Host-specific, non-secret settings (database host, proxy, LLM router) come
# from a service env file outside the repository:
#   ${TELEGRAM_INSIGHTS_SERVICE_ENV:-~/.config/telegram-insights/service.env}
#   TI_PG_HOST=<postgres host>          required
#   TELEGRAM_PROXY=socks5://host:port   optional
#   LLM_ROUTER_BASE_URL=http://.../v1   optional, embeddings and answers
set -eu
umask 077

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
service_env="${TELEGRAM_INSIGHTS_SERVICE_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/telegram-insights/service.env}"
if [ -f "$service_env" ]; then
  set -a; . "$service_env"; set +a
fi
pg_host="${TI_PG_HOST:?TI_PG_HOST is not set; put it into $service_env}"

secret() {
  pass show "$1" | head -1
}

dsn() {
  printf 'postgres://telegram_insights_%s:%s@%s:5432/telegram_insights?sslmode=no-verify' "$1" "$(secret "telegram-insights/postgres/$1-password")" "$pg_host"
}

command="${1:-}"
case "$command" in
  migrate)
    TI_OWNER_DATABASE_URL="$(dsn owner)"; export TI_OWNER_DATABASE_URL ;;
  run|login)
    # The session is a copy of tgcli's authorization, so use tgcli's API app.
    eval "$(python3 -c 'import json,os,shlex;d=json.load(open(os.path.expanduser("~/Library/Application Support/tgcli/config.json")));print("TELEGRAM_API_ID="+shlex.quote(str(d["apiId"]))+"; TELEGRAM_API_HASH="+shlex.quote(d["apiHash"]))')"
    export TELEGRAM_API_ID TELEGRAM_API_HASH
    TI_ARCHIVER_DATABASE_URL="$(dsn archiver)"; export TI_ARCHIVER_DATABASE_URL
    TI_INDEXER_DATABASE_URL="$(dsn indexer)"; export TI_INDEXER_DATABASE_URL ;;
  index)
    TI_INDEXER_DATABASE_URL="$(dsn indexer)"; export TI_INDEXER_DATABASE_URL ;;
  doctor)
    TI_OWNER_DATABASE_URL="$(dsn owner)"; export TI_OWNER_DATABASE_URL
    TI_ARCHIVER_DATABASE_URL="$(dsn archiver)"; export TI_ARCHIVER_DATABASE_URL
    TI_INDEXER_DATABASE_URL="$(dsn indexer)"; export TI_INDEXER_DATABASE_URL
    TI_READER_DATABASE_URL="$(dsn reader)"; export TI_READER_DATABASE_URL ;;
  *)
    TI_READER_DATABASE_URL="$(dsn reader)"; export TI_READER_DATABASE_URL ;;
esac

export TELEGRAM_INSIGHTS_STORE="${TELEGRAM_INSIGHTS_STORE:-$HOME/Library/Application Support/telegram-insights}"

exec node "$repo/bin/telegram-insights.js" "$@"
